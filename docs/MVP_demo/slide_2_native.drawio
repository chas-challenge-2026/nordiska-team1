                <mxCell id="a3_up" edge="1" parent="1" style="endArrow=block;endFill=1;dashed=1;html=1;strokeColor=#9333EA;strokeWidth=3;fontSize=14;fontStyle=1;fontColor=#000000;labelBackgroundColor=#FFFFFF;" value="TimeStampToken">
