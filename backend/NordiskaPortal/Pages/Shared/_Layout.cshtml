<!DOCTYPE html>
<html lang="sv">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Nordiska Sparbanken</title>
    <!-- Bootstrap 3 from CDN — old fashioned, intentional -->
    <link rel="stylesheet" href="https://maxcdn.bootstrapcdn.com/bootstrap/3.3.7/css/bootstrap.min.css" />
    <style>
        body { background-color: #f5f5f5; }
        .navbar-default { background-color: #ffffff; border-color: #1a5276; border-bottom: 2px solid #f5a623; }
        .navbar-default .navbar-brand,
        .navbar-default .navbar-nav > li > a { color: #1a5276; }
        .navbar-default .navbar-nav > li > a:hover { color: #f5a623; background-color: transparent; }
        .panel-heading { background-color: #1a5276 !important; color: #fff !important; }
        .footer { margin-top: 40px; padding: 20px 0; border-top: 1px solid #ddd; color: #777; text-align: center; }
        .balance-amount { font-size: 2em; color: #1a5276; font-weight: bold; }
    </style>
</head>
<body>
    <nav class="navbar navbar-default">
        <div class="container">
            <div class="navbar-header">
                <a class="navbar-brand" href="/"><img src="/images/logo.png" alt="Nordiska Sparbanken" style="height:30px;vertical-align:middle;"></a>
            </div>
            <div class="collapse navbar-collapse">
                <ul class="nav navbar-nav">
                    @if (Context.Session.GetString("CustomerId") != null)
                    {
                        <li><a href="/Dashboard">Mitt konto</a></li>
                        <li><a href="/Deposit">Insättning / Uttag</a></li>
                        <li><a href="/TaxReport">Skatteunderlag</a></li>
                        <li><a href="/Faq">Vanliga frågor</a></li>
                        <li><a href="/Logout">Logga ut</a></li>
                    }
                    else
                    {
                        <li><a href="/">Logga in</a></li>
                    }
                </ul>
            </div>
        </div>
    </nav>

    <div class="container" style="margin-top: 30px;">
        @RenderBody()
    </div>

    <div class="footer">
        <p>&copy; 2024 Nordiska Sparbanken AB &mdash; Organisationsnr: 556789-1234</p>
    </div>

    <script src="https://ajax.googleapis.com/ajax/libs/jquery/1.12.4/jquery.min.js"></script>
    <script src="https://maxcdn.bootstrapcdn.com/bootstrap/3.3.7/js/bootstrap.min.js"></script>
</body>
</html>
