<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="coverlet.collector" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="Moq" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\Nordiska.Reporting.Worker\Nordiska.Reporting.Worker.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <NativePdfBuildDirectory>$(MSBuildThisFileDirectory)..\..\..\native\pdf_generator\build</NativePdfBuildDirectory>
  </PropertyGroup>

  <ItemGroup>
    <NativePdfRuntimeFiles Include="$(NativePdfBuildDirectory)\*.dll" />
  </ItemGroup>

  <Target Name="CopyNativePdfRuntime" AfterTargets="Build">
    <Copy
      Condition="'@(NativePdfRuntimeFiles)' != ''"
      SourceFiles="@(NativePdfRuntimeFiles)"
      DestinationFolder="$(TargetDir)"
      SkipUnchangedFiles="true" />
  </Target>
</Project>