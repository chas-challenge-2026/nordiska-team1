<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="coverlet.collector" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\Modules\Reporting\Nordiska.Modules.Reporting.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <NativePdfBuildDirectory>$(MSBuildThisFileDirectory)..\..\..\native\pdf_generator\build</NativePdfBuildDirectory>
  </PropertyGroup>

  <ItemGroup>
    <NativePdfRuntimeFiles Include="$(NativePdfBuildDirectory)\*.dll" />
  </ItemGroup>

  <Target Name="CopyNativePdfRuntime" AfterTargets="Build" Condition="'$(OS)' == 'Windows_NT'">
    <Error
      Condition="'@(NativePdfRuntimeFiles)' == ''"
      Text="Native PDF runtime not found. Build native/pdf_generator before building Nordiska.Modules.Reporting.Tests." />
    <Copy
      SourceFiles="@(NativePdfRuntimeFiles)"
      DestinationFolder="$(TargetDir)"
      SkipUnchangedFiles="true" />
  </Target>
</Project>