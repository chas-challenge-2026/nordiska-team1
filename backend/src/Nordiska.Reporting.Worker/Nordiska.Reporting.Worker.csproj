<Project Sdk="Microsoft.NET.Sdk.Worker">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <UserSecretsId>dotnet-Nordiska.Reporting.Worker-b45cfeb9-b601-4420-acf7-12164ebf31ee</UserSecretsId>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="Npgsql" />
    <None Update="sample-input-huge.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Modules\Reporting\Nordiska.Modules.Reporting.csproj" />
    <ProjectReference Include="..\BuildingBlocks\Database\Nordiska.BuildingBlocks.Database.csproj" />
    <InternalsVisibleTo Include="Nordiska.Reporting.Worker.Tests" />
  </ItemGroup>

  <PropertyGroup>
    <NativePdfBuildDirectory Condition="'$(NativePdfBuildDirectory)' == ''">$(MSBuildThisFileDirectory)../../../native/pdf_generator/build</NativePdfBuildDirectory>
  </PropertyGroup>

  <ItemGroup>
    <NativePdfRuntimeFiles Include="$(NativePdfBuildDirectory)/*.dll;$(NativePdfBuildDirectory)/*.so;$(NativePdfBuildDirectory)/*.so.*" />
    <Content Include="@(NativePdfRuntimeFiles)" Link="%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <Target Name="WarnMissingNativePdfRuntime" BeforeTargets="Build">
    <Warning
      Condition="'@(NativePdfRuntimeFiles)' == ''"
      Text="Native PDF runtime not found. Build native/pdf_generator or set NativePdfBuildDirectory to its build directory before running PDF generation." />
  </Target>

</Project>
