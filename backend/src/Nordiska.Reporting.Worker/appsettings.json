{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "ConnectionStrings": {
    "ReportingDatabase": "DEVELOPMENT_PLACEHOLDER_OVERRIDDEN_BY_ENVIRONMENT"
  },
  "ReportDocumentStorage": {
    "RootPath": "/var/lib/nordiska/report-documents"
  },

  "PdfSigner": {
    "CertificatePassphrase": "DEVELOPMENT_PLACEHOLDER_OVERRIDDEN_BY_USER_SECRETS"
  },
  "TaxReportWorker": {
    "PollIntervalSeconds": 2,
    "LeaseDurationMinutes": 5,
    "RetryDelaySeconds": 30,
    "MaximumAttempts": 3
  }
}
