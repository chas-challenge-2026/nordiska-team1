{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "DEVELOPMENT_PLACEHOLDER_OVERRIDDEN_BY_USER_SECRETS",
    "BankingDatabase": "DEVELOPMENT_PLACEHOLDER_OVERRIDDEN_BY_USER_SECRETS",
    "FaqDatabase": "DEVELOPMENT_PLACEHOLDER_OVERRIDDEN_BY_USER_SECRETS",
    "ReportingDatabase": "DEVELOPMENT_PLACEHOLDER_OVERRIDDEN_BY_USER_SECRETS"
  },
  "Jwt": {
    "SecretKey": "DEVELOPMENT_PLACEHOLDER_OVERRIDDEN_BY_USER_SECRETS",
    "Issuer": "NordiskaSparbanken",
    "Audience": "NordiskaSparbankenPortal",
    "TokenLifetimeInMinutes": 15
  },
  "Lockout": {
    "MaxFailedAccessAttempts": 5,
    "LockoutMinutes": 15
  },
  "RateLimiting": {
    "Auth": {
      "PermitLimit": 10,
      "WindowSeconds": 60
    },
    "Transactions": {
      "PermitLimit": 10,
      "WindowSeconds": 60,
      "SegmentsPerWindow": 6
    }
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:5173",
      "http://localhost:5174",
      "http://localhost:4173",
      "http://localhost:3000"
    ]
  },
  "AuditLogging": {
    "SigningKey": "Nordiska-Secure-Audit-HMAC-Key-2026-v1"
  }
}
